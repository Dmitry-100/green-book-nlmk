FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci \
  --fetch-retries=5 \
  --fetch-retry-mintimeout=20000 \
  --fetch-retry-maxtimeout=120000 \
  --fetch-timeout=300000 \
  --loglevel=notice

COPY . .
RUN npm run build

# Unprivileged-вариант официального образа: nginx работает не от root,
# наш конфиг слушает 5173 (>1024), привилегии не нужны.
FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY nginx.offline.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 5173

HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:5173 || exit 1
